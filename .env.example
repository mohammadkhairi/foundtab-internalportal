# FoundTab Portal Monorepo — environment variables
# Copy apps/web/.env.example to apps/web/.env.local
# Copy apps/api/.env.example to apps/api/.env.local

# apps/web/.env.local
# PORTAL_API_URL=http://localhost:4000
# PORTAL_INTERNAL_SECRET=<min 32 chars, must match api>
# NEXT_PUBLIC_APP_ENV=local
# NEXTAUTH_SECRET=<random 64 hex chars>
# NEXTAUTH_URL=http://localhost:3001
# PORTAL_ALLOWED_EMAILS=you@example.com
# PORTAL_ADMIN_PASSWORD=<password>

# apps/api/.env.local
# PORT=4000
# FOUNDTAB_API_URL=http://localhost:8080
# FOUNDTAB_ADMIN_API_KEY=<must match ADMIN_API_KEY in foundtab-backend>
# PORTAL_INTERNAL_SECRET=<min 32 chars, must match web>
